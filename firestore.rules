rules_version = '2';

// Band Flow · «Mi banda»
// - El director crea la banda y su código de invitación.
// - Los músicos entran con el código. Solo ven su propio progreso; el director ve el de todos y el jefe de cuerda el de su sección.
// - De los compañeros solo se ve la ficha: apodo, instrumento, voz, nivel y minutos de práctica de las dos últimas semanas.
//   Racha, afinación, puntos, minutos del trimestre y último ensayo van en members/{uid}/private/stats (él y el director).
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    // Validación de datos: los textos tienen tamaño máximo y los números son números (defensa contra datos manipulados)
    function shortText(v, max) { return v is string && v.size() <= max; }
    function optNumber(d, k) { return !(k in d) || d[k] is number; }
    function validCode(c) { return c.matches('^[A-Z2-9]{6}$'); }
    function bandPath(bandId) { return /databases/$(db)/documents/bands/$(bandId); }
    function isDirector(bandId) { return signedIn() && get(bandPath(bandId)).data.directorUid == request.auth.uid; }
    function isDirectorAfter(bandId) { return signedIn() && getAfter(bandPath(bandId)).data.directorUid == request.auth.uid; }
    function isMember(bandId) { return signedIn() && exists(/databases/$(db)/documents/bands/$(bandId)/members/$(request.auth.uid)); }

    // Cuentas: el progreso de cada usuario solo lo lee y escribe él mismo
    // Administrador: dado de alta en admins/{uid} o el uid de la cuenta del dueño (respaldo; un uid no es un dato personal)
    // El cliente lo comprueba leyendo admins/{uid} o, si no existe, adminData/probe (solo lo permite isAdmin())
    function isAdmin() {
      return signedIn() && (exists(/databases/$(db)/documents/admins/$(request.auth.uid))
        || request.auth.uid == 'OxA5RXkTzXQ2ggKkzDOlQoEmVGM2');
    }
    function isOwn(uid) { return signedIn() && uid == request.auth.uid; }
    // Progreso sincronizado (sync.js push): { state, savedAt } y nada más. El documento entero lo acota Firestore (1 MiB);
    // aquí solo que el estado sea un mapa con un número razonable de claves (hoy unas 75)
    function validUserDoc(d) {
      return d.keys().hasOnly(['state', 'savedAt']) && d.state is map && d.state.size() <= 1000 && optNumber(d, 'savedAt');
    }
    match /users/{uid} {
      allow read, delete: if isOwn(uid);
      allow create, update: if isOwn(uid) && validUserDoc(request.resource.data);
    }
    // Roles (tester pro): los da el administrador desde el panel de testers; cada uno solo lee el suyo (y lo borra con su cuenta)
    match /roles/{uid} {
      allow get: if isOwn(uid) || isAdmin();
      allow list, write: if isAdmin();
      allow delete: if isOwn(uid);
    }
    // Resumen de cada tester: lo escribe él y lo lee el administrador (panel de testers)
    // Solo los campos de testerSummary() en sync.js (se reescribe entero con setDoc), con textos y listas acotados
    function optText(d, k, max) { return !(k in d) || d[k] == null || shortText(d[k], max); }
    function optList(d, k, max) { return !(k in d) || (d[k] is list && d[k].size() <= max); }
    function testerKeys() {
      return ['name', 'email', 'instrument', 'instruments', 'xp', 'level', 'lessons', 'minutes', 'daysPracticed', 'firstDay',
        'lastPractice', 'streak', 'badges', 'features', 'instrumentIds', 'band', 'platform', 'createdAt', 'lastSeen'];
    }
    function validTester(d) {
      return d.keys().hasOnly(testerKeys()) && shortText(d.name, 60)
        && optText(d, 'email', 320) && optText(d, 'instrument', 24) && optText(d, 'level', 60) && optText(d, 'band', 200)
        && optText(d, 'platform', 60) && optText(d, 'firstDay', 20) && optText(d, 'lastPractice', 20)
        && optList(d, 'instruments', 64) && optList(d, 'instrumentIds', 64) && optList(d, 'features', 200)
        && optNumber(d, 'minutes') && optNumber(d, 'lessons') && optNumber(d, 'daysPracticed') && optNumber(d, 'xp')
        && optNumber(d, 'streak') && optNumber(d, 'badges') && optNumber(d, 'createdAt') && optNumber(d, 'lastSeen');
    }
    match /testers/{uid} {
      allow read: if (signedIn() && uid == request.auth.uid) || isAdmin();
      allow delete: if isOwn(uid);
      allow create, update: if isOwn(uid) && validTester(request.resource.data);
    }
    // Administradores: se dan de alta a mano desde la consola; cada uno solo puede comprobar si lo es
    // Datos del panel del administrador (checklist de pruebas)
    match /adminData/{doc} {
      allow read, write: if isAdmin();
    }
    match /admins/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list, write: if false;
    }

    // ---------- Amigos ----------
    function isFriendOf(owner) { return signedIn() && exists(/databases/$(db)/documents/friends/$(owner)/list/$(request.auth.uid)); }
    // Código de amigo → uid. Se consulta uno a uno (no hay buscador público: la app la usan niños)
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    // Perfil: lo ven tú y tus amigos
    match /profiles/{uid} {
      allow read: if (signedIn() && uid == request.auth.uid) || isFriendOf(uid);
      allow delete: if isOwn(uid);
      allow create, update: if isOwn(uid)
        && (!('name' in request.resource.data) || shortText(request.resource.data.name, 60))
        && optNumber(request.resource.data, 'streak') && optNumber(request.resource.data, 'weekMinutes')
        && optNumber(request.resource.data, 'xp') && optNumber(request.resource.data, 'badges');
    }
    // Solicitudes: las escribe quien la envía (solo nombre, instrumento y hora); las lee y borra quien la recibe (o quien la envió)
    match /requests/{to}/in/{from} {
      allow create: if signedIn() && from == request.auth.uid && to != from
        && request.resource.data.keys().hasOnly(['fromName', 'fromInstrument', 'at'])
        && shortText(request.resource.data.fromName, 60)
        && (!('fromInstrument' in request.resource.data) || shortText(request.resource.data.fromInstrument, 24))
        && optNumber(request.resource.data, 'at');
      allow read: if signedIn() && (to == request.auth.uid || from == request.auth.uid);
      allow delete: if signedIn() && (to == request.auth.uid || from == request.auth.uid);
    }
    // Amistad en los dos sentidos: solo al aceptar una solicitud; cualquiera de los dos puede deshacerla
    match /friends/{owner}/list/{fid} {
      allow read: if signedIn() && owner == request.auth.uid;
      allow create: if signedIn() && (
        (owner == request.auth.uid && exists(/databases/$(db)/documents/requests/$(owner)/in/$(fid))) ||
        (fid == request.auth.uid && exists(/databases/$(db)/documents/requests/$(fid)/in/$(owner))));
      allow delete: if signedIn() && (owner == request.auth.uid || fid == request.auth.uid);
    }
    // Muro: lo escribe su dueño; lo leen sus amigos, que solo pueden poner o quitar su propia reacción
    match /activity/{owner}/events/{id} {
      allow read: if (signedIn() && owner == request.auth.uid) || isFriendOf(owner);
      allow create, delete: if signedIn() && owner == request.auth.uid;
      allow update: if isFriendOf(owner)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.reactions) || request.resource.data.reactions[request.auth.uid] in ['👏', '❤️', '🔥']);
    }
    // Avisos dentro de la app: los dejan tus amigos (solo estos campos y textos cortos); solo tú los lees y los borras
    match /inbox/{owner}/items/{id} {
      allow create: if isFriendOf(owner) && request.resource.data.kind in ['reaction', 'cheer', 'play']
        && request.resource.data.keys().hasOnly(['kind', 'emoji', 'fromName', 'text', 'at'])
        && shortText(request.resource.data.fromName, 60)
        && (!('emoji' in request.resource.data) || shortText(request.resource.data.emoji, 8))
        && (!('text' in request.resource.data) || shortText(request.resource.data.text, 300))
        && optNumber(request.resource.data, 'at');
      allow read, delete: if signedIn() && owner == request.auth.uid;
    }

    // Código de invitación → banda. Se consulta uno a uno, nunca se listan.
    match /bandCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if validCode(code) && isDirectorAfter(request.resource.data.bandId);
      allow delete: if isDirector(resource.data.bandId);
    }

    function validName() { return request.resource.data.name is string && request.resource.data.name.size() <= 30; }
    function validAccuracy() { return request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 1; }

    // Resultado de un reto, de una canción o del reto del día (social-api.js submitScore, que reescribe el documento entero)
    function validResult() {
      return validName() && validAccuracy()
        && request.resource.data.keys().hasOnly(['name', 'score', 'stars', 'instrument', 'at'])
        && (!('stars' in request.resource.data) || request.resource.data.stars == null || request.resource.data.stars is number)
        && optText(request.resource.data, 'instrument', 24)
        && (!('at' in request.resource.data) || request.resource.data.at is timestamp);
    }
    // Partitura que viaja en un reto o una partitura compartida (band-api.js songPayload): datos de la canción y las
    // notas comprimidas { n, b, t }. Los títulos importados de MusicXML pueden ser largos: 200 caracteres
    function validSongPayload(s) {
      return s is map && s.keys().hasOnly(['title', 'by', 'key', 'time', 'bpm', 'pickup', 'enc'])
        && shortText(s.title, 200) && optText(s, 'by', 200)
        && s.enc is map && s.enc.keys().hasOnly(['n', 'b', 't']);
    }
    // social-api.js createWithCode: { song, ownerName, (instrument), ownerUid, createdAt } con la hora del servidor
    function validShared(d, keys) {
      return d.keys().hasOnly(keys) && d.ownerUid == request.auth.uid && validSongPayload(d.song)
        && shortText(d.ownerName, 60) && d.createdAt == request.time;
    }

    // Partituras compartidas y retos: se leen por código; solo su autor los crea, los borra o los lista (para borrarlos con su cuenta)
    match /sharedScores/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() && validCode(code)
        && validShared(request.resource.data, ['song', 'ownerName', 'ownerUid', 'createdAt']);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
    match /challenges/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() && validCode(code)
        && validShared(request.resource.data, ['song', 'instrument', 'ownerName', 'ownerUid', 'createdAt'])
        && optText(request.resource.data, 'instrument', 24);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      match /results/{uid} {
        allow read: if signedIn();
        allow create, update: if isOwn(uid) && validResult();
        allow delete: if isOwn(uid);
      }
    }

    // Clasificaciones abiertas por canción e instrumento, y del reto del día: cada uno escribe (y borra) solo su resultado
    match /boards/{board}/results/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwn(uid) && validResult();
      allow delete: if isOwn(uid);
    }
    match /daily/{board}/results/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwn(uid) && validResult();
      allow delete: if isOwn(uid);
    }
    // Liga semanal: puntos acumulados con la hora del servidor en «at». Como mucho una suma por minuto de 120 puntos
    // (varias lecciones acumuladas en el cliente, league.js) y 5000 en la semana.
    function validLeague() {
      return validName() && request.resource.data.score is number && request.resource.data.at == request.time
        && request.resource.data.score <= 5000
        && request.resource.data.keys().hasOnly(['name', 'instrument', 'score', 'stars', 'at']);
    }
    match /leagues/{board}/results/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && uid == request.auth.uid && validLeague()
        && request.resource.data.score >= 0 && request.resource.data.score <= 120;
      allow update: if signedIn() && uid == request.auth.uid && validLeague()
        && request.resource.data.score >= resource.data.score
        && request.resource.data.score <= resource.data.score + 120
        && request.time > resource.data.get('at', timestamp.value(0)) + duration.value(60, 's');
      allow delete: if isOwn(uid);
    }

    match /bands/{bandId} {
      allow read: if isMember(bandId) || isDirector(bandId) || isAdmin();
      allow create: if signedIn() && request.resource.data.directorUid == request.auth.uid;
      // El director cambia su banda; al borrar su cuenta puede pasar la dirección a un músico que ya esté en ella
      allow update: if isDirector(bandId) && (request.resource.data.directorUid == resource.data.directorUid
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['directorUid', 'directorName'])
          && request.resource.data.directorUid is string && request.resource.data.directorUid != request.auth.uid
          && exists(/databases/$(db)/documents/bands/$(bandId)/members/$(request.resource.data.directorUid))
          && shortText(request.resource.data.directorName, 60)));
      allow delete: if isDirector(bandId);

      // Ficha de músico (la ve toda la banda): voz 1-4 o vacía, textos cortos, nivel y minutos de 14 días como mucho
      function validMember(d) {
        return (!('voice' in d) || d.voice == null || d.voice in [1, 2, 3, 4])
          && shortText(d.nickname, 60) && (!('instrument' in d) || shortText(d.instrument, 24))
          && (!('level' in d) || shortText(d.level, 40))
          && (!('minutes' in d) || (d.minutes is map && d.minutes.size() <= 14))
          && optNumber(d, 'syncedAt');
      }
      // Lo que el músico sube de sí mismo a su ficha (band-api.js publishActivity y la voz en band-member.js);
      // nunca papel, código ni apodo
      function ownMemberKeys() {
        return ['voice', 'instrument', 'minutes', 'level', 'syncedAt'];
      }
      // Lo que las fichas antiguas tenían a la vista de todos: ya solo se puede borrar (va en private/stats)
      function legacyMemberKeys() {
        return ['days', 'xp', 'points', 'streak', 'tuning', 'lastPractice'];
      }
      function ownMemberChange(d, old) {
        return d.diff(old).affectedKeys().hasOnly(ownMemberKeys().concat(legacyMemberKeys()))
          && !d.diff(old).addedKeys().hasAny(legacyMemberKeys()) && !d.diff(old).changedKeys().hasAny(legacyMemberKeys());
      }
      // Un jefe de cuerda no se cambia de instrumento (vería el progreso de otra sección); un músico sí
      function keepsSection(d, old) {
        return old.get('role', 'member') != 'leader' || d.get('instrument', null) == old.get('instrument', null);
      }
      // Estadísticas privadas: solo estos campos, con tamaño acotado y «at» con la hora del servidor
      function validStats(d) {
        return d.keys().hasOnly(['days', 'points', 'streak', 'tuning', 'lastPractice', 'at'])
          && d.at == request.time && d.points is number && d.points >= 0 && optNumber(d, 'streak')
          && (!('days' in d) || (d.days is map && d.days.size() <= 92))
          && (!('tuning' in d) || (d.tuning is map && d.tuning.size() <= 128))
          && (!('lastPractice' in d) || d.lastPractice == null || shortText(d.lastPractice, 10));
      }
      // Puntos de la banda (premios y clasificación) = xp − xp al entrar. Como en la liga: una escritura por minuto y
      // como mucho 120 puntos más cada vez (lo acumulado sin conexión entra en varias); solo bajan a 0 (al reiniciar)
      function validStatsPoints(d, before) {
        return d.points == 0 || (d.points >= before && d.points <= before + 120);
      }
      match /members/{uid} {
        allow read: if isMember(bandId) || isDirector(bandId) || isAdmin();
        allow create: if signedIn() && uid == request.auth.uid && validMember(request.resource.data)
          && !('points' in request.resource.data) && !('xp' in request.resource.data) && (
          (request.resource.data.role == 'director' && isDirectorAfter(bandId)) ||
          (request.resource.data.role == 'member'
            && get(/databases/$(db)/documents/bandCodes/$(request.resource.data.code)).data.bandId == bandId)
        );
        // Cada uno su ficha (solo sus campos de actividad, sin cambiarse el papel); el director solo la voz y el papel
        allow update: if validMember(request.resource.data) && (
          (signedIn() && uid == request.auth.uid && request.resource.data.role == resource.data.role
            && ownMemberChange(request.resource.data, resource.data)
            && keepsSection(request.resource.data, resource.data))
          || (isDirector(bandId) && resource.data.role != 'director'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'voice'])
              && request.resource.data.role in ['member', 'leader'])
          // Traspaso: el músico que recibe la dirección pasa a «director» en la misma escritura
          || (isDirector(bandId) && getAfter(bandPath(bandId)).data.directorUid == uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
              && request.resource.data.role == 'director'));
        allow delete: if (signedIn() && uid == request.auth.uid) || isDirector(bandId);

        // Estadísticas privadas del músico: las lee él y el director (nunca el resto de la banda); solo las escribe él
        match /private/{docId} {
          allow read: if (signedIn() && uid == request.auth.uid) || isDirector(bandId);
          // La primera vez parten de los puntos que tenía a la vista la ficha antigua (se borran en la misma escritura)
          allow create: if signedIn() && uid == request.auth.uid && docId == 'stats' && isMember(bandId)
            && validStats(request.resource.data)
            && validStatsPoints(request.resource.data, get(/databases/$(db)/documents/bands/$(bandId)/members/$(uid)).data.get('points', 0));
          allow update: if signedIn() && uid == request.auth.uid && docId == 'stats' && isMember(bandId)
            && validStats(request.resource.data)
            && validStatsPoints(request.resource.data, resource.data.get('points', 0))
            && request.time > resource.data.get('at', timestamp.value(0)) + duration.value(60, 's');
          allow delete: if (signedIn() && uid == request.auth.uid) || isDirector(bandId);
        }
      }

      match /tasks/{taskId} {
        allow read: if isMember(bandId) || isDirector(bandId);
        allow create, update, delete: if isDirector(bandId);
      }

      // Agenda, avisos, premios y archivo de partituras: los pone el director y los ve toda la banda
      match /{sub}/{docId} {
        allow read: if sub in ['events', 'notices', 'rewards', 'library'] && (isMember(bandId) || isDirector(bandId));
        allow create, update, delete: if sub in ['events', 'notices', 'rewards', 'library'] && isDirector(bandId);
      }

      // Un documento por tarea y músico: «<tarea>_<uid>»
      // Lo ve su músico, el director y el jefe de cuerda de ese instrumento
      match /progress/{docId} {
        function me() { return get(/databases/$(db)/documents/bands/$(bandId)/members/$(request.auth.uid)).data; }
        allow read: if isDirector(bandId) || (signedIn() && (resource == null || resource.data.uid == request.auth.uid
          || (me().role == 'leader' && resource.data.instrument == me().instrument)));
        allow create, update: if isMember(bandId)
          && request.resource.data.uid == request.auth.uid
          && docId == request.resource.data.taskId + '_' + request.auth.uid
          && request.resource.data.attempts is number && request.resource.data.minutes is number
          && request.resource.data.bestStars is number && request.resource.data.bestStars <= 3
          && shortText(request.resource.data.nickname, 60)
          && (!('instrument' in request.resource.data) || request.resource.data.instrument == null || shortText(request.resource.data.instrument, 24))
          && (resource == null || (request.resource.data.get('stamp', null) == resource.data.get('stamp', null)
              && request.resource.data.get('comment', null) == resource.data.get('comment', null)));
        // El director solo pone su sello y su comentario
        allow update: if isDirector(bandId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stamp', 'comment', 'stampAt']);
        // El músico borra el suyo al borrar su cuenta; el director, cualquiera
        allow delete: if isDirector(bandId) || (signedIn() && resource.data.uid == request.auth.uid);
      }
    }
    // ---------- Grupos (beta): grupos pequeños que ensayan cada uno en su casa ----------
    // Cada canción tiene una maqueta y una pista por músico; el audio va troceado en documentos de menos de 1 MiB.
    function groupPath(gid) { return /databases/$(db)/documents/groups/$(gid); }
    function inGroup(gid) { return signedIn() && exists(/databases/$(db)/documents/groups/$(gid)/members/$(request.auth.uid)); }
    function groupOwner(gid) { return signedIn() && get(groupPath(gid)).data.ownerUid == request.auth.uid; }
    function validGroupMember(d) { return shortText(d.nickname, 30) && shortText(d.instrument, 24) && validCode(d.code); }
    function validGroupSong(d) {
      return shortText(d.title, 80) && d.bpm is number && d.sections is list && d.sections.size() <= 40 && d.parts is map && d.parts.size() <= 10;
    }
    function ownTrack(tid) { return tid == request.auth.uid || tid == 'demo'; }
    match /groupCodes/{code} {
      allow get: if signedIn();
      allow list, update: if false;
      allow create: if signedIn() && validCode(code) && shortText(request.resource.data.groupName, 60)
        && getAfter(groupPath(request.resource.data.groupId)).data.ownerUid == request.auth.uid;
      allow delete: if groupOwner(resource.data.groupId);
    }
    match /groups/{gid} {
      allow get: if inGroup(gid) || isAdmin();
      allow list: if isAdmin(); // métricas del administrador
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && shortText(request.resource.data.name, 60) && validCode(request.resource.data.code);
      // El dueño cambia el nombre; al borrar su cuenta puede pasar el grupo a otro miembro
      allow update: if groupOwner(gid) && shortText(request.resource.data.name, 60)
        && (request.resource.data.ownerUid == resource.data.ownerUid
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid'])
            && request.resource.data.ownerUid is string && request.resource.data.ownerUid != request.auth.uid
            && exists(/databases/$(db)/documents/groups/$(gid)/members/$(request.resource.data.ownerUid))));
      allow delete: if groupOwner(gid);
      match /members/{uid} {
        allow read: if inGroup(gid) || isAdmin();
        // Para entrar hace falta el código del grupo (el del documento de códigos debe apuntar a este grupo)
        allow create, update: if signedIn() && uid == request.auth.uid && validGroupMember(request.resource.data)
          && getAfter(/databases/$(db)/documents/groupCodes/$(request.resource.data.code)).data.groupId == gid;
        allow delete: if (signedIn() && uid == request.auth.uid) || groupOwner(gid);
      }
      match /songs/{sid} {
        // Autor de la canción (createdBy) o dueño del grupo: la borran, cambian título y tempo y quitan partes.
        // El resto de músicos solo toca su propia pista (o la maqueta) en «parts» y las partes de la canción
        // («Marcar parte aquí» y su apunte): la lista nunca se acorta y crece como mucho una parte por escritura.
        // (Las reglas no recorren listas: un músico podría reescribir el apunte de otro, pero no quitar partes.)
        function songAuthorOrOwner() { return resource.data.createdBy == request.auth.uid || groupOwner(gid); }
        allow read: if inGroup(gid) || isAdmin();
        allow delete: if inGroup(gid) && songAuthorOrOwner();
        allow create: if inGroup(gid) && request.resource.data.createdBy == request.auth.uid && validGroupSong(request.resource.data);
        allow update: if inGroup(gid) && validGroupSong(request.resource.data) && request.resource.data.createdBy == resource.data.createdBy
          && (songAuthorOrOwner()
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parts', 'sections', 'updatedAt'])
              && request.resource.data.parts.diff(resource.data.parts).affectedKeys().hasOnly([request.auth.uid, 'demo'])
              && request.resource.data.sections.size() >= resource.data.sections.size()
              && request.resource.data.sections.size() <= resource.data.sections.size() + 1));
        // Pista: la del músico (tid = su uid) solo la sube él; la maqueta, quien la subió («by»), el autor de la canción
        // o el dueño del grupo (o cualquiera si aún no hay). El dueño del grupo puede borrar cualquier pista.
        function trackPath(tid) { return /databases/$(db)/documents/groups/$(gid)/songs/$(sid)/tracks/$(tid); }
        function songAuthor() { return get(/databases/$(db)/documents/groups/$(gid)/songs/$(sid)).data.createdBy == request.auth.uid; }
        function trackAuthor(tid) {
          return tid == request.auth.uid
            || (tid == 'demo' && (!exists(trackPath(tid)) || get(trackPath(tid)).data.get('by', null) == request.auth.uid
              || songAuthor() || groupOwner(gid)));
        }
        match /tracks/{tid} {
          allow read: if inGroup(gid);
          allow delete: if inGroup(gid) && (trackAuthor(tid) || groupOwner(gid));
          allow create, update: if inGroup(gid) && ownTrack(tid) && trackAuthor(tid) && request.resource.data.by == request.auth.uid
            && shortText(request.resource.data.nickname, 30)
            && request.resource.data.duration is number && request.resource.data.duration <= 330;
          match /chunks/{n} {
            allow read: if inGroup(gid);
            allow delete: if inGroup(gid) && (trackAuthor(tid) || groupOwner(gid));
            allow create, update: if inGroup(gid) && ownTrack(tid) && trackAuthor(tid)
              && request.resource.data.data is bytes && request.resource.data.data.size() <= 720000;
          }
        }
      }
    }
    // ---------- Escuelas de música (premium) ----------
    // El profesor crea la escuela; los alumnos entran con el código y solo ven lo suyo. La licencia la pone el administrador.
    function schoolPath(sid) { return /databases/$(db)/documents/schools/$(sid); }
    function schoolMember(sid, uid) { return /databases/$(db)/documents/schools/$(sid)/members/$(uid); }
    function schoolOwner(sid) { return signedIn() && get(schoolPath(sid)).data.ownerUid == request.auth.uid; }
    function inSchool(sid) { return signedIn() && exists(schoolMember(sid, request.auth.uid)); }
    function schoolLimit(d) { return ('premium' in d) && d.premium.active == true ? 200 : 5; }
    // Plazas: la ficha de un alumno solo se crea si en la MISMA escritura la escuela suma exactamente uno y antes cabía
    // en la licencia; solo se borra si resta exactamente uno sin bajar de 0 (o si la escuela desaparece con ella)
    function seatTaken(sid) {
      let before = get(schoolPath(sid)).data;
      return before.students < schoolLimit(before) && getAfter(schoolPath(sid)).data.students == before.students + 1;
    }
    function seatFreed(sid) {
      return !existsAfter(schoolPath(sid))
        || (get(schoolPath(sid)).data.students >= 1
          && getAfter(schoolPath(sid)).data.students == get(schoolPath(sid)).data.students - 1);
    }
    match /schoolCodes/{code} {
      allow get: if signedIn();
      allow list, update: if false;
      allow create: if signedIn() && validCode(code) && shortText(request.resource.data.schoolName, 80)
        && getAfter(schoolPath(request.resource.data.schoolId)).data.ownerUid == request.auth.uid;
      allow delete: if schoolOwner(resource.data.schoolId);
    }
    match /schools/{sid} {
      allow get: if schoolOwner(sid) || inSchool(sid) || isAdmin();
      allow list: if isAdmin();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && shortText(request.resource.data.name, 80)
        && validCode(request.resource.data.code) && !('premium' in request.resource.data) && request.resource.data.students == 0;
      // El profesor cambia el nombre y el curso escolar; nunca la licencia. Al dar de baja a un alumno resta uno
      // indicando quién sale («leftUid»), y su ficha debe borrarse en la misma escritura.
      allow update: if (schoolOwner(sid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'year'])
            && shortText(request.resource.data.name, 80))
        || (schoolOwner(sid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['students', 'leftUid'])
            && request.resource.data.students == resource.data.students - 1 && resource.data.students >= 1
            && request.resource.data.leftUid is string
            && exists(schoolMember(sid, request.resource.data.leftUid)) && !existsAfter(schoolMember(sid, request.resource.data.leftUid)))
        // Un alumno que entra suma uno (si cabe en la licencia) y uno que sale resta uno, siempre junto a su ficha
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['students'])
            && ((request.resource.data.students == resource.data.students + 1 && resource.data.students < schoolLimit(resource.data)
                 && !exists(schoolMember(sid, request.auth.uid)) && existsAfter(schoolMember(sid, request.auth.uid)))
              || (request.resource.data.students == resource.data.students - 1 && resource.data.students >= 1
                 && exists(schoolMember(sid, request.auth.uid)) && !existsAfter(schoolMember(sid, request.auth.uid)))))
        // Al borrar su cuenta, el profesor puede pasar la escuela a alguien que ya esté en ella
        || (schoolOwner(sid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'ownerName'])
            && request.resource.data.ownerUid is string && request.resource.data.ownerUid != request.auth.uid
            && exists(schoolMember(sid, request.resource.data.ownerUid)) && shortText(request.resource.data.ownerName, 60))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['premium']))
        // Aula Pro: el profesor pide la licencia (la ve el administrador en su panel), con la hora del servidor
        || (schoolOwner(sid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proRequestedAt'])
            && request.resource.data.proRequestedAt == request.time);
      allow delete: if schoolOwner(sid);
      match /members/{uid} {
        allow read: if schoolOwner(sid) || (signedIn() && uid == request.auth.uid) || isAdmin();
        allow create: if signedIn() && uid == request.auth.uid && shortText(request.resource.data.nickname, 30)
          && shortText(request.resource.data.instrument, 24) && validCode(request.resource.data.code) && request.resource.data.level == 1
          && getAfter(/databases/$(db)/documents/schoolCodes/$(request.resource.data.code)).data.schoolId == sid
          && seatTaken(sid);
        allow update: if (signedIn() && uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'instrument'])
            && shortText(request.resource.data.nickname, 30) && shortText(request.resource.data.instrument, 24))
          || (schoolOwner(sid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['level', 'instrument'])
            && request.resource.data.level in [1, 2, 3]);
        allow delete: if ((signedIn() && uid == request.auth.uid) || schoolOwner(sid)) && seatFreed(sid);
      }
      match /progress/{uid} {
        allow read: if schoolOwner(sid) || (signedIn() && uid == request.auth.uid) || isAdmin();
        allow create, update: if signedIn() && uid == request.auth.uid && inSchool(sid)
          && request.resource.data.done is number && request.resource.data.total is number && shortText(request.resource.data.nickname, 30);
        allow delete: if schoolOwner(sid) || (signedIn() && uid == request.auth.uid);
      }

      // ---------- Aula Pro: clases del profesor (js/aula-api.js) ----------
      // Solo con la licencia de la escuela se crean clases y entran alumnos. El profesor ve SOLO sus clases; cada alumno,
      // su ficha, su resumen y los comentarios a sus entregas (nunca a sus compañeros). Validación estricta de claves.
      match /classes/{cid} {
        function validClass(d) {
          return d.keys().hasOnly(['name', 'code', 'teacherName', 'students', 'createdAt', 'archived', 'leftUid', 'closed'])
            && shortText(d.name, 60) && shortText(d.teacherName, 60) && validCode(d.code)
            && d.students is int && d.students >= 0 && d.students <= aulaClassLimit()
            && (!('archived' in d) || d.archived is bool) && (!('closed' in d) || d.closed is bool)
            && (!('leftUid' in d) || shortText(d.leftUid, 128));
        }
        allow get: if schoolOwner(sid) || inClass(sid, cid);
        allow list: if schoolOwner(sid);
        allow create: if schoolOwner(sid) && aulaActive(sid) && validClass(request.resource.data)
          && request.resource.data.students == 0 && request.resource.data.createdAt == request.time
          && !('leftUid' in request.resource.data);
        // El profesor cambia el nombre, la archiva, cambia el código o cierra las inscripciones (el código nuevo se crea en
        // classCodes en la misma escritura); al dar de baja resta uno indicando quién sale (con su ficha borrada
        // en la misma escritura). Un alumno que entra suma uno (si cabe) y uno que sale resta uno, junto a su ficha.
        allow update: if validClass(request.resource.data) && (
          (schoolOwner(sid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'archived', 'code', 'closed']))
          // tras dar de baja, el profesor borra «leftUid»: la clase no guarda el identificador de quien salió
          || (schoolOwner(sid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leftUid']) && !('leftUid' in request.resource.data))
          || (schoolOwner(sid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['students', 'leftUid'])
              && request.resource.data.students == resource.data.students - 1 && resource.data.students >= 1
              && exists(classStudent(sid, cid, request.resource.data.leftUid))
              && !existsAfter(classStudent(sid, cid, request.resource.data.leftUid)))
          || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['students'])
              && ((request.resource.data.students == resource.data.students + 1 && resource.data.students < aulaClassLimit()
                   && !exists(classStudent(sid, cid, request.auth.uid)) && existsAfter(classStudent(sid, cid, request.auth.uid)))
                || (request.resource.data.students == resource.data.students - 1 && resource.data.students >= 1
                   && exists(classStudent(sid, cid, request.auth.uid)) && !existsAfter(classStudent(sid, cid, request.auth.uid))))));
        allow delete: if schoolOwner(sid);

        // Ficha del alumno en la clase: entra con el código de ESTA clase, ocupando una plaza en la misma escritura
        match /students/{uid} {
          allow get: if schoolOwner(sid) || isOwn(uid);
          allow list: if schoolOwner(sid);
          allow create: if isOwn(uid) && aulaActive(sid)
            && request.resource.data.keys().hasOnly(['nickname', 'instrument', 'code', 'joinedAt'])
            && shortText(request.resource.data.nickname, 30) && shortText(request.resource.data.instrument, 24)
            && validCode(request.resource.data.code) && request.resource.data.joinedAt == request.time
            && get(/databases/$(db)/documents/classCodes/$(request.resource.data.code)).data.classId == cid
            && get(/databases/$(db)/documents/classCodes/$(request.resource.data.code)).data.schoolId == sid
            && classSeatTaken(sid, cid);
          allow update: if isOwn(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'instrument'])
            && shortText(request.resource.data.nickname, 30) && shortText(request.resource.data.instrument, 24);
          allow delete: if (isOwn(uid) || schoolOwner(sid)) && classSeatFreed(sid, cid);
        }
        // Tareas: las pone el profesor y las ve la clase
        match /tasks/{tid} {
          allow read: if schoolOwner(sid) || inClass(sid, cid);
          // Con la licencia caducada el profesor solo lee (y puede borrar): no pone tareas nuevas ni las cambia
          allow create, update: if schoolOwner(sid) && aulaActive(sid) && validAulaTask(request.resource.data);
          allow delete: if schoolOwner(sid);
        }
        // Resumen acotado que publica el alumno (aula-summary.js buildSummary); lo lee el profesor
        match /summaries/{uid} {
          allow get: if schoolOwner(sid) || isOwn(uid);
          allow list: if schoolOwner(sid);
          allow create, update: if isOwn(uid) && inClass(sid, cid) && validAulaSummary(request.resource.data);
          allow delete: if schoolOwner(sid) || isOwn(uid);
        }
        // Composición del curso de Lenguaje (creatividad) que el alumno envía a su profesor: «<uid>_<ejercicio>»
        match /works/{wid} {
          allow get: if schoolOwner(sid) || (signedIn() && resource.data.uid == request.auth.uid);
          allow list: if schoolOwner(sid) || (signedIn() && resource.data.uid == request.auth.uid);
          allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid && inClass(sid, cid)
            && validAulaWork(request.resource.data) && wid == request.resource.data.uid + '_' + request.resource.data.exId;
          allow delete: if schoolOwner(sid) || (signedIn() && resource.data.uid == request.auth.uid);
        }
        // Comentario del profesor a una entrega («<tarea>_<uid>»): lo escribe él y lo lee ese alumno
        match /feedback/{fid} {
          allow read: if schoolOwner(sid) || (signedIn() && resource.data.uid == request.auth.uid);
          allow create, update: if schoolOwner(sid) && aulaActive(sid) && validFeedback(request.resource.data)
            && fid == request.resource.data.taskId + '_' + request.resource.data.uid;
          // El alumno no borra los comentarios de su profesor mientras sigue en la clase: solo al salir (o al borrar su cuenta),
          // en la misma escritura que quita su ficha
          allow delete: if schoolOwner(sid) || (signedIn() && resource.data.uid == request.auth.uid
            && !existsAfter(classStudent(sid, cid, request.auth.uid)));
        }
      }
    }

    // ---------- Aula Pro: funciones comunes ----------
    function aulaClassLimit() { return 60; }
    // Licencia vigente: activa y sin caducar («until» AAAA-MM-DD, incluido ese día), igual que school.js premiumActive
    function aulaActive(sid) {
      let p = get(schoolPath(sid)).data.get('premium', {});
      return p.get('active', false) == true && (p.get('until', null) == null || licenseLive(p.until));
    }
    function licenseLive(until) {
      let d = string(until).split('-');
      return d.size() == 3 && request.time < timestamp.date(int(d[0]), int(d[1]), int(d[2])) + duration.value(1, 'd');
    }
    function classPath(sid, cid) { return /databases/$(db)/documents/schools/$(sid)/classes/$(cid); }
    function classStudent(sid, cid, uid) { return /databases/$(db)/documents/schools/$(sid)/classes/$(cid)/students/$(uid); }
    function inClass(sid, cid) { return signedIn() && exists(classStudent(sid, cid, request.auth.uid)); }
    function classSeatTaken(sid, cid) {
      let before = get(classPath(sid, cid)).data;
      return before.students < aulaClassLimit() && getAfter(classPath(sid, cid)).data.students == before.students + 1;
    }
    function classSeatFreed(sid, cid) {
      return !existsAfter(classPath(sid, cid))
        || (get(classPath(sid, cid)).data.students >= 1
          && getAfter(classPath(sid, cid)).data.students == get(classPath(sid, cid)).data.students - 1);
    }
    function optInt(d, k, lo, hi) { return !(k in d) || (d[k] is int && d[k] >= lo && d[k] <= hi); }
    function optPct(d, k) { return !(k in d) || (d[k] is number && d[k] >= 0 && d[k] <= 100); }
    // Tarea (aula.js normalizeTask): qué del temario, fecha «AAAA-MM-DD» o null, nota mínima, intentos y a quién
    function validAulaRef(r) {
      return r is map && r.keys().hasOnly(['level', 'unit', 'section', 'id', 'inst', 'book', 'label', 'ids'])
        && optInt(r, 'level', 1, 20) && optInt(r, 'unit', 1, 50) && optInt(r, 'book', 1, 10)
        && optText(r, 'section', 20) && optText(r, 'id', 80) && optText(r, 'inst', 24) && optText(r, 'label', 160)
        && (!('ids' in r) || (r.ids is list && r.ids.size() >= 1 && r.ids.size() <= 20));
    }
    function validAulaTask(d) {
      return d.keys().hasOnly(['title', 'kind', 'ref', 'due', 'minPct', 'maxAttempts', 'variant', 'to', 'note', 'createdAt', 'song'])
        && shortText(d.title, 120) && d.kind in ['lm-unit', 'lm-section', 'lm-ex', 'lesson', 'book', 'method', 'xml']
        && validAulaRef(d.ref)
        && (d.due == null || (d.due is string && d.due.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && d.minPct is int && d.minPct >= 0 && d.minPct <= 100
        && d.maxAttempts is int && d.maxAttempts >= 0 && d.maxAttempts <= 20
        && d.variant in ['facil', 'medio', 'any']
        && d.to is list && d.to.size() <= 60
        && optText(d, 'note', 300) && d.createdAt is number
        && (!('song' in d) || (d.kind == 'xml' && validSongPayload(d.song)));
    }
    // Resumen del alumno: claves fijas, textos cortos, % de 0 a 100 y mapas y listas con tope
    function validAulaSkills(s) {
      return s is map && s.keys().hasOnly(['ritmo', 'entonacion', 'lectura', 'teoria', 'dictado', 'audicion'])
        && optPct(s, 'ritmo') && optPct(s, 'entonacion') && optPct(s, 'lectura')
        && optPct(s, 'teoria') && optPct(s, 'dictado') && optPct(s, 'audicion');
    }
    // Resumen: lo que tiene muchas entradas viaja como texto (js/aula-wire.js) y aquí se valida ENTERO: cada %, 0-100;
    // cada fecha, AAAA-MM-DD; cada contador, un número; nada de HTML ni de claves inventadas
    function validAulaSummary(d) {
      return d.keys().hasOnly(['nickname', 'instrument', 'at', 'term', 'days', 'streak', 'skills', 'mistakes', 'units', 'tasks', 'recent', 'prevTerm', 'prevSkills'])
        && shortText(d.nickname, 30) && optText(d, 'instrument', 24)
        && shortText(d.term, 12) && d.term.matches('[0-9]{4}-[0-9]{4}-[1-3]')
        && d.at is int && d.at > 0 && d.at <= request.time.toMillis() + 600000
        && d.streak is int && d.streak >= 0 && d.streak <= 5000
        && shortText(d.days, 1500) && d.days.matches('([0-9]{4}-[01][0-9]-[0-3][0-9]=[0-9]{1,4};){0,92}')
        && validAulaSkills(d.skills)
        && shortText(d.mistakes, 260) && d.mistakes.matches('([A-Za-z0-9_#+.>-]{1,16}=[0-9]{1,4};){0,10}')
        && shortText(d.units, 800) && d.units.matches('(l[0-9]{1,2}u[0-9]{1,2}=(100|[1-9]?[0-9]);){0,64}')
        && shortText(d.tasks, 6000) && d.tasks.matches('([A-Za-z0-9_-]{1,40}=(100|[1-9]?[0-9]),[0-9]{1,3},[01],[0-9]{1,13},[01];){0,100}')
        && shortText(d.recent, 1700) && d.recent.matches('([A-Za-z0-9_-]{1,60}=(100|[1-9]?[0-9])@[0-9]{1,13};){0,20}')
        && (!('prevTerm' in d) || (shortText(d.prevTerm, 12) && d.prevTerm.matches('[0-9]{4}-[0-9]{4}-[1-3]')))
        && (!('prevSkills' in d) || validAulaSkills(d.prevSkills));
    }
    // Composición: notas en texto («C4q D4h Rq», como js/lm/notes.js tokensText), letra opcional y lo que comprobó la app
    function validAulaWork(d) {
      return d.keys().hasOnly(['uid', 'nickname', 'exId', 'title', 'score', 'lyrics', 'meter', 'pct', 'at'])
        && shortText(d.uid, 128) && shortText(d.nickname, 30) && shortText(d.title, 80)
        && shortText(d.exId, 40) && d.exId.matches('lm[0-9]+-u[0-9]+-creatividad-[a-c]-(facil|medio)')
        && shortText(d.score, 800) && d.score.matches('[A-GR#b0-9whqes. ]+')
        && optText(d, 'lyrics', 200) && shortText(d.meter, 6) && d.meter.matches('[0-9]+/[0-9]+')
        && d.pct is int && d.pct >= 0 && d.pct <= 100 && d.at is number;
    }
    function validFeedback(d) {
      return d.keys().hasOnly(['uid', 'taskId', 'comment', 'at'])
        && shortText(d.uid, 128) && shortText(d.taskId, 40) && shortText(d.comment, 500) && d.comment.size() > 0 && d.at is number;
    }
    // Para entrar en una clase: el código lleva a la escuela y la clase (lo crea el profesor junto a la clase)
    match /classCodes/{code} {
      allow get: if signedIn();
      allow list, update: if false;
      allow create: if signedIn() && validCode(code)
        && request.resource.data.keys().hasOnly(['schoolId', 'classId', 'className', 'teacherName'])
        && shortText(request.resource.data.schoolId, 40) && shortText(request.resource.data.classId, 40)
        && shortText(request.resource.data.className, 60) && shortText(request.resource.data.teacherName, 60)
        && get(schoolPath(request.resource.data.schoolId)).data.ownerUid == request.auth.uid
        && getAfter(classPath(request.resource.data.schoolId, request.resource.data.classId)).data.code == code;
      allow delete: if schoolOwner(resource.data.schoolId);
    }
  }
}
